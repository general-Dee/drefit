# --- Database: Neon Postgres (Vercel Marketplace, store "drefit-db") ---
# Pooled connection string used by the app. On Vercel it is injected by the
# Neon integration; locally use `vercel env pull .env.local` or a local
# Postgres, e.g. postgres://drefit:drefit@localhost:5432/drefit_dev
DATABASE_URL=postgres://user:password@localhost:5432/drefit_dev
# Optional: direct (non-pooled) URL. Scripts (migrate/seed/import) prefer it.
DATABASE_URL_UNPOOLED=
# Optional: max connections per server instance (default 5)
PG_POOL_MAX=
# Set to 1 to make `npm run build` fail if the migration cannot run.
MIGRATE_STRICT=

# --- Progress photos: private Vercel Blob store ("drefit-photos") ---
# Injected on Vercel by the Blob integration. Without it photo upload/serve
# returns 503 and everything else works.
BLOB_READ_WRITE_TOKEN=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key
RESEND_API_KEY=your_resend_api_key
# Sender for password-reset emails. onboarding@resend.dev works without domain
# verification for dev/testing — replace with a verified sender domain in production.
FROM_EMAIL=onboarding@resend.dev
# Comma-separated emails that get role: "admin" when their account is created.
ADMIN_EMAILS=you@example.com

# --- WhatsApp (optional; nothing is sent until all of these are set) ---
# Coach's WhatsApp number for the "Chat with your coach" button (E.164).
# Defaults to +2348165510842 in code when unset.
NEXT_PUBLIC_COACH_WHATSAPP=+2348165510842
# WhatsApp Cloud API (Meta) permanent token + sender phone number id
# (WHATSAPP_PHONE_NUMBER_ID is Meta's numeric ID from the WhatsApp Manager, NOT a phone number)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template names. Body params:
#   workout reminder: {{1}} first name, {{2}} workout name
#   payment due:      {{1}} first name, {{2}} days left, {{3}} end date (YYYY-MM-DD), {{4}} "free trial"/"subscription"
#   payment failed:   {{1}} first name
WHATSAPP_TEMPLATE_WORKOUT_REMINDER=
WHATSAPP_TEMPLATE_PAYMENT_DUE=
WHATSAPP_TEMPLATE_PAYMENT_FAILED=
# Optional: template language (default en), Graph API version (default v21.0)
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=
# Protects /api/cron/reminders (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# "daily" (default, Vercel Hobby daily cron) or "hourly" (if an hourly scheduler calls the route)
REMINDER_CRON_MODE=daily
